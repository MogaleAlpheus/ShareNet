<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ShareNet</AssemblyName>
    <RootNamespace>ShareNet</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>ShareNet.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFAC010: this is a WPF app that only uses WinForms for the tray icon;
         WPF still requires per-monitor DPI settings in the manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Version>0.2.1</Version>
    <AssemblyVersion>0.2.1.0</AssemblyVersion>
    <FileVersion>0.2.1.0</FileVersion>
    <Product>ShareNet</Product>
    <Company>ShareNet</Company>
    <Description>Share a phone's VPN connection with this PC</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Update="tools\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The brand icon is an embedded resource so the tray and the window read
         exactly the file that ships, not a copy drawn in code. -->
    <Resource Include="ShareNet.ico" />
  </ItemGroup>

</Project>
