<Window x:Class="ShareNet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShareNet"
        Title="ShareNet"
        Width="1180"
        Height="664"
        MinWidth="1040"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootFrame"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- ======================== TITLE BAR ======================== -->
            <Border Grid.Row="0"
                    Background="{StaticResource ChromeBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Brand  -->
                    <StackPanel Orientation="Horizontal"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                        <Border Width="25"
                                Height="25"
                                CornerRadius="7"
                                Background="{StaticResource LogoTileBrush}"
                                BorderBrush="#26355C"
                                BorderThickness="1">
                            <Path Data="M16.32,7.2 C13.2,4.44 7.92,6.12 12,12 C16.08,17.88 10.8,19.56 7.68,16.8"
                                  Stroke="{StaticResource BrandGradientBrush}"
                                  StrokeThickness="2.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="24"
                                  Height="24"
                                  Stretch="None"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="ShareNet"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                        <Border Width="1"
                                Height="13"
                                Background="{StaticResource BorderBrush}"
                                Margin="12,0,12,0"
                                VerticalAlignment="Center" />
                        <TextBlock Text="Phone VPN for Windows"
                                   Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!--  Window controls  -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0">
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource WindowButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize">
                            <Path Data="{StaticResource IconMinimize}" Style="{StaticResource WindowGlyph}" />
                        </Button>
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource WindowButtonStyle}"
                                Click="MaximizeButton_Click"
                                ToolTip="Maximize">
                            <Path x:Name="MaximizeGlyph"
                                  Data="{StaticResource IconMaximize}"
                                  Style="{StaticResource WindowGlyph}" />
                        </Button>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource CloseButtonStyle}"
                                Click="CloseButton_Click"
                                ToolTip="Close to tray">
                            <Path Data="{StaticResource IconClose}"
                                  Style="{StaticResource WindowGlyph}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================== BODY ======================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="412" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Connection panel  -->
                <Border Grid.Column="0"
                        Background="{StaticResource BgElevatedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <DockPanel Margin="24,20,24,20">

                        <!--  Primary action stays pinned  -->
                        <StackPanel DockPanel.Dock="Bottom">
                            <Button x:Name="ConnectButton"
                                    Content="Connect"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ConnectButton_Click" />
                            <Grid Margin="0,9,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconUsb}"
                                          Style="{StaticResource Icon}"
                                          Width="13"
                                          Height="13"
                                          Stroke="{StaticResource TextMutedBrush}"
                                          StrokeThickness="1.7" />
                                    <TextBlock Text="via"
                                               Style="{StaticResource Caption}"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0" />
                                    <TextBlock x:Name="TransportText"
                                               Text="USB cable"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,4,0">
                            <StackPanel>

                                <!--  Status  -->
                                <Grid>
                                    <TextBlock Text="CONNECTION"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0"
                                               VerticalAlignment="Center" />
                                    <Border x:Name="StatusPill"
                                            HorizontalAlignment="Right"
                                            Background="{StaticResource Surface2Brush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="8,3">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="StatusDot"
                                                     Width="6"
                                                     Height="6"
                                                     Fill="{StaticResource TextMutedBrush}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock x:Name="StatusPillText"
                                                       Text="Stopped"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="StatusText"
                                           Text="Ready to connect"
                                           Style="{StaticResource Display}"
                                           FontSize="19"
                                           TextWrapping="Wrap"
                                           Margin="0,14,0,0" />

                                <TextBlock x:Name="StatusDetail"
                                           Text="Choose USB or Wi-Fi below. Every Windows app will use the phone's connection."
                                           Style="{StaticResource Caption}"
                                           Margin="0,6,0,0" />

                                <TextBlock x:Name="ErrorText"
                                           Visibility="Collapsed"
                                           Foreground="{StaticResource ErrorBrush}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           LineHeight="17"
                                           Margin="0,9,0,0" />

                                <Border Height="1"
                                        Background="{StaticResource BorderBrush}"
                                        Margin="0,18,0,18" />

                                <!--  Transport  -->
                                <TextBlock Text="TRANSPORT" Style="{StaticResource FieldLabel}" />
                                <Border Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="UsbModeButton"
                                                     GroupName="Mode"
                                                     Content="USB cable"
                                                     IsChecked="True"
                                                     Style="{StaticResource SegmentStyle}"
                                                     Checked="Mode_Changed" />
                                        <RadioButton x:Name="WifiModeButton"
                                                     Grid.Column="1"
                                                     GroupName="Mode"
                                                     Content="Wi-Fi"
                                                     Style="{StaticResource SegmentStyle}"
                                                     Checked="Mode_Changed" />
                                    </Grid>
                                </Border>

                                <!--  USB setup  -->
                                <StackPanel x:Name="UsbPanel" Margin="0,16,0,0">
                                    <TextBlock Text="PHONE" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="104" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="DeviceCombo" Grid.Column="0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontFamily="{StaticResource UiFont}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button x:Name="RefreshButton"
                                                Grid.Column="2"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="RefreshButton_Click"
                                                ToolTip="Look for connected phones">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconRefresh}"
                                                      Style="{StaticResource Icon}"
                                                      Width="14"
                                                      Height="14"
                                                      StrokeThickness="1.8" />
                                                <TextBlock Text="Scan"
                                                           Margin="7,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="UsbHint"
                                               Text="Enable Developer options → USB debugging on the phone, connect the cable, then accept the debugging prompt."
                                               Style="{StaticResource Caption}"
                                               Margin="0,9,0,0" />
                                </StackPanel>

                                <!--  Wi-Fi setup  -->
                                <StackPanel x:Name="WifiPanel"
                                            Margin="0,16,0,0"
                                            Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PHONE ADDRESS" Style="{StaticResource FieldLabel}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="HostBox"
                                                         Style="{StaticResource InputTextBoxStyle}"
                                                         ToolTip="For example 192.168.43.1" />
                                                <Button x:Name="FindPhoneButton"
                                                        Grid.Column="2"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="Find"
                                                        Height="40"
                                                        Padding="13,0"
                                                        Click="FindPhoneButton_Click"
                                                        ToolTip="Look for the phone on this network" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="PORT" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="1080"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     IsReadOnly="True"
                                                     Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,13,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}" />
                                            <PasswordBox x:Name="PasswordInput"
                                                         Style="{StaticResource InputPasswordBoxStyle}"
                                                         ToolTip="The 16-character password shown in the phone app" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="ADAPTER" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="AdapterCombo">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Display}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontFamily="{StaticResource UiFont}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock x:Name="WifiHint"
                                               Text="Press Connect to find the phone, or to join the hotspot it opens. The password is shown in the phone app and is remembered after the first connection."
                                               Style="{StaticResource Caption}"
                                               Margin="0,9,0,0" />
                                </StackPanel>

                                <!--  Tunnel facts  -->
                                <Border Height="1"
                                        Background="{StaticResource BorderBrush}"
                                        Margin="0,20,0,16" />

                                <TextBlock Text="TUNNEL" Style="{StaticResource FieldLabel}" />

                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconSliders}"
                                          Style="{StaticResource Icon}"
                                          Width="13"
                                          Height="13"
                                          Stroke="{StaticResource TextMutedBrush}"
                                          StrokeThickness="1.8" />
                                    <TextBlock Grid.Column="1"
                                               Text="Routing"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="System-wide TUN"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconPulse}"
                                          Style="{StaticResource Icon}"
                                          Width="13"
                                          Height="13"
                                          Stroke="{StaticResource TextMutedBrush}"
                                          StrokeThickness="1.8" />
                                    <TextBlock Grid.Column="1"
                                               Text="DNS"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="From the phone"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconRefresh}"
                                          Style="{StaticResource Icon}"
                                          Width="13"
                                          Height="13"
                                          Stroke="{StaticResource TextMutedBrush}"
                                          StrokeThickness="1.8" />
                                    <TextBlock Grid.Column="1"
                                               Text="Link loss"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="Auto-disconnect"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!--  Traffic workspace  -->
                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="26,22,26,24">

                        <!--  Page header  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Live traffic"
                                           Style="{StaticResource Display}"
                                           FontSize="17" />
                                <TextBlock Text="Real-time throughput through the phone link."
                                           Style="{StaticResource Caption}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource BrandSoftBrush}"
                                    BorderBrush="#26375A"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="9,4">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconBolt}"
                                          Style="{StaticResource Icon}"
                                          Width="11"
                                          Height="11"
                                          Stroke="{StaticResource BrandStrongBrush}"
                                          StrokeThickness="1.8" />
                                    <TextBlock Text="UNCAPPED"
                                               FontSize="9.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrandStrongBrush}"
                                               Margin="5,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--  Throughput card  -->
                        <Border Style="{StaticResource CardStyle}"
                                Padding="0"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <Grid Margin="22,17,22,0">
                                    <TextBlock Text="THROUGHPUT"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!--  Download band  -->
                                <Grid Margin="22,14,22,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconDown}"
                                              Style="{StaticResource Icon}"
                                              Width="15"
                                              Height="15"
                                              Stroke="{StaticResource BrandBrush}"
                                              StrokeThickness="1.9" />
                                        <TextBlock Text="Download"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="7,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <TextBlock x:Name="DownRateText"
                                                   Text="0.0"
                                                   Style="{StaticResource Display}"
                                                   FontSize="30" />
                                        <TextBlock x:Name="DownRateUnit"
                                                   Text="B/s"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="7,0,0,6"
                                                   VerticalAlignment="Bottom" />
                                    </StackPanel>
                                </Grid>
                                <local:Sparkline x:Name="DownSpark"
                                                 Height="64"
                                                 Margin="22,8,22,0"
                                                 LineBrush="{StaticResource BrandBrush}" />

                                <Border Height="1"
                                        Background="{StaticResource BorderBrush}"
                                        Margin="22,14,22,0" />

                                <!--  Upload band  -->
                                <Grid Margin="22,14,22,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconUp}"
                                              Style="{StaticResource Icon}"
                                              Width="15"
                                              Height="15"
                                              Stroke="{StaticResource AccentBrush}"
                                              StrokeThickness="1.9" />
                                        <TextBlock Text="Upload"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="7,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <TextBlock x:Name="UpRateText"
                                                   Text="0.0"
                                                   Style="{StaticResource Display}"
                                                   FontSize="30" />
                                        <TextBlock x:Name="UpRateUnit"
                                                   Text="B/s"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="7,0,0,6"
                                                   VerticalAlignment="Bottom" />
                                    </StackPanel>
                                </Grid>
                                <local:Sparkline x:Name="UpSpark"
                                                 Height="64"
                                                 Margin="22,8,22,18"
                                                 LineBrush="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </Border>

                        <!--  Totals  -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconDown}"
                                              Style="{StaticResource Icon}"
                                              Width="12"
                                              Height="12"
                                              Stroke="{StaticResource TextMutedBrush}"
                                              StrokeThickness="2" />
                                        <TextBlock Text="DOWNLOADED"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="5,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="DownTotalText"
                                               Text="0 B"
                                               Style="{StaticResource Display}"
                                               FontSize="16.5"
                                               Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconUp}"
                                              Style="{StaticResource Icon}"
                                              Width="12"
                                              Height="12"
                                              Stroke="{StaticResource TextMutedBrush}"
                                              StrokeThickness="2" />
                                        <TextBlock Text="UPLOADED"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="5,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="UpTotalText"
                                               Text="0 B"
                                               Style="{StaticResource Display}"
                                               FontSize="16.5"
                                               Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource TileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconClock}"
                                              Style="{StaticResource Icon}"
                                              Width="12"
                                              Height="12"
                                              Stroke="{StaticResource TextMutedBrush}"
                                              StrokeThickness="2" />
                                        <TextBlock Text="SESSION"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="5,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="SessionText"
                                               Text="00:00"
                                               Style="{StaticResource Display}"
                                               FontSize="16.5"
                                               Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--  Activity  -->
                        <Border Style="{StaticResource CardStyle}"
                                Padding="0"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <Button x:Name="ActivityToggle"
                                        Click="ActivityToggle_Click"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root"
                                                    Background="Transparent"
                                                    CornerRadius="12"
                                                    Padding="20,14">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#12161D" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconPulse}"
                                                  Style="{StaticResource Icon}"
                                                  Width="14"
                                                  Height="14"
                                                  Stroke="{StaticResource TextSecondaryBrush}"
                                                  StrokeThickness="1.8" />
                                            <TextBlock Text="Activity"
                                                       Style="{StaticResource SectionTitle}"
                                                       FontSize="13"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="ActivitySummary"
                                                       Text="No activity yet"
                                                       Style="{StaticResource Caption}"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Path x:Name="ActivityChevron"
                                              Data="{StaticResource IconChevron}"
                                              Style="{StaticResource Icon}"
                                              Width="14"
                                              Height="14"
                                              Stroke="{StaticResource TextMutedBrush}"
                                              StrokeThickness="1.8"
                                              HorizontalAlignment="Right"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </Button>
                                <TextBox x:Name="LogBox"
                                         Style="{StaticResource LogTextBoxStyle}"
                                         Height="168"
                                         Margin="20,0,20,18"
                                         Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ======================== STATUS BAR ======================== -->
            <Border Grid.Row="2"
                    Background="{StaticResource ChromeBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="VpnDot"
                                 Width="6"
                                 Height="6"
                                 Fill="{StaticResource TextMutedBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="VpnText"
                                   Text="Checking VPN status…"
                                   Style="{StaticResource Caption}"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Border x:Name="AdminBadge"
                                Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="7,2">
                            <TextBlock x:Name="AdminBadgeText"
                                       Text="ADMIN"
                                       FontSize="9"
                                       FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="v0.2.1"
                                   Style="{StaticResource Caption}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
