<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#182035" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#24304A" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#27334D" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#3A4A68" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E2942" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#33415C" />
        </shape>
    </item>
</selector>
