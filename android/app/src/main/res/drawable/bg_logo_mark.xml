<?xml version="1.0" encoding="utf-8"?>
<!-- Graphite brand tile: the launcher's navy/teal identity in the app's own surface
     language, so the header mark reads as part of the UI instead of a sticker. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:startColor="#1B2434"
                android:endColor="#0B0F16" />
            <stroke
                android:width="1dp"
                android:color="#2B3849" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <gradient
                android:centerX="0.5"
                android:centerY="0.32"
                android:endColor="#0014D9B4"
                android:gradientRadius="72%p"
                android:startColor="#2E14D9B4"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
